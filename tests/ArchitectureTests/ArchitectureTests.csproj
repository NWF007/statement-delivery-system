<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    Deliberately references ONLY the building blocks, never the services. Two reasons:
    the rules about services are rules about the PROJECT graph, and are checked by reading the
    .csproj files themselves - which is stricter, because it catches a reference that compiles
    away to nothing; and a test project that referenced all four executables would be exempting
    itself from the very rule it enforces.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Messaging\Messaging.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\ServiceDefaults\ServiceDefaults.csproj" />

    <!-- EVERY deployable, so the IL-level rules can actually read them.
         A test project may reference a deployable; the rule that dependencies point inwards applies
         to src/BuildingBlocks, and BuildingBlocks_ShouldNotDependOn_Services enforces it by reading
         the .csproj graph, which does not include this project.

         The two workers were added in Prompt 4 and their absence was a real hole: the DataKey rule
         inspects assemblies found in this project's output, so Generation.Worker - the service
         Prompt 5 builds around the key hierarchy - was silently outside the rule meant to stop key
         material reaching a service. A rule that cannot fire for the likeliest offender is not a
         rule. -->
    <ProjectReference Include="..\..\src\Services\Delivery.Api\Delivery.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Download.Gateway\Download.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Services\Generation.Worker\Generation.Worker.csproj" />
    <ProjectReference Include="..\..\src\Services\Retention.Worker\Retention.Worker.csproj" />
    <ProjectReference Include="..\..\src\Migrations\Db.Migrator\Db.Migrator.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Rendering\Rendering.csproj" />
    <ProjectReference Include="..\..\src\Services\MockLedger.Api\MockLedger.Api.csproj" />
    <ProjectReference Include="..\..\tools\renderhash\RenderHash.csproj" />
  </ItemGroup>

</Project>
