<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Deterministic, reproducible builds. SourceLink-free for now: there is no remote yet.
      ContinuousIntegrationBuild is set by CI (see .github/workflows/ci.yml).
    -->
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!--
      service.version is emitted as an OpenTelemetry resource attribute and by /ping.
      Keep VersionPrefix here so every assembly reports the same platform version.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    Test projects: xUnit v3 requires an executable host, and .NET 10's `dotnet test`
    only supports Microsoft.Testing.Platform (opted into via global.json). Documentation
    generation is pointless for test assemblies.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
