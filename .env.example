# =============================================================================================
#  Local development configuration for docker compose.
#
#  Copy to .env before running the stack:
#      cp .env.example .env
#
#  .env is gitignored; .env.example is committed. Every value below is a LOCAL DEVELOPMENT
#  credential with no meaning outside this machine. In a deployed environment none of these
#  exist: database passwords come from a secret manager, object storage uses a workload identity
#  with no long-lived key at all, and JWT signing keys are never symmetric.
# =============================================================================================

# ---- Environment ----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---- PostgreSQL (superuser; used by the container and by Db.Migrator only) --------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-postgres-password
POSTGRES_DB=statements
POSTGRES_PORT=5432

# ---- Least-privilege application roles (created by migration V001) ---------------------------
# One role per service. app_retention is the only role anywhere with DELETE.
APP_DELIVERY_PASSWORD=local-dev-delivery-password
APP_DOWNLOAD_PASSWORD=local-dev-download-password
APP_GENERATION_PASSWORD=local-dev-generation-password
APP_RETENTION_PASSWORD=local-dev-retention-password
APP_MIGRATOR_PASSWORD=local-dev-migrator-password

# PgBouncer's own admin/stats account, for SHOW POOLS. Never used by an application.
PGBOUNCER_ADMIN_PASSWORD=local-dev-pgbouncer-password
PGBOUNCER_PORT=6432

# ---- Redis --------------------------------------------------------------------------------
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----------------------------------------------------
MINIO_ROOT_USER=local-dev-minio
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STATEMENTS_BUCKET=statements

# ---- JWT (Delivery.Api) ----------------------------------------------------------------------
# DEVELOPMENT ONLY. JwtOptionsValidator refuses to start the service if a symmetric signing key
# is present outside Development, so this cannot reach a deployed environment by being forgotten.
# Must be at least 32 characters for HMAC-SHA256.
JWT_ISSUER=https://localhost/statement-delivery-dev
JWT_AUDIENCE=statement-delivery-api
JWT_DEV_SIGNING_KEY=local-dev-signing-key-at-least-32-chars

# ---- Published ports -------------------------------------------------------------------------
DELIVERY_API_PORT=8081
DOWNLOAD_GATEWAY_PORT=8082
ASPIRE_DASHBOARD_PORT=18888

# ---- Read replica ----------------------------------------------------------------------------
# TODO(scale): no streaming replica runs by default, so ConnectionIntent.ReadEventual falls back
# to the primary and NpgsqlConnectionFactory logs a warning at startup. That warning is the
# intended behaviour: the fallback is visible rather than silent.
#
# To exercise the read/write split locally, start the profile-gated replica:
#     docker compose --profile replica up -d postgres-replica
# and then set, for the services that should use it:
#     POSTGRES_REPLICA_CONNECTION=Host=postgres-replica;Port=5432;Database=statements;Username=app_delivery;Password=local-dev-delivery-password
POSTGRES_REPLICA_CONNECTION=
