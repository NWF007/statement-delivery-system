{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "MaxPoolSize": 5,
    "MinPoolSize": 0,
    "ConnectTimeoutSeconds": 5,
    "WriteCommandTimeoutSeconds": 300,
    "ReadStrongCommandTimeoutSeconds": 30,
    "ReadEventualCommandTimeoutSeconds": 300,
    "MaxAutoPrepare": 20
  },
  "Lease": {
    "TimeToLiveSeconds": 30
  },
  "Partitioning": {
    "MaintenanceEnabled": false,
    "IntervalMinutes": 60,
    "Tables": [
      {
        "Table": "outbox",
        "Granularity": "day",
        "PeriodsAhead": 7
      },
      {
        "Table": "statement",
        "Granularity": "month",
        "PeriodsAhead": 3
      },
      {
        "Table": "audit_event",
        "Granularity": "month",
        "PeriodsAhead": 3
      },
      {
        "Table": "download_token",
        "Granularity": "day",
        "PeriodsAhead": 7
      }
    ]
  },
  "GracefulShutdown": {
    "DrainSeconds": 5,
    "ShutdownTimeoutSeconds": 30
  },
  "Cache": {
    "InstanceName": "retention-worker:"
  },
  "Retention": {
    "LeaseName": "retention-sweep",
    "SweepIntervalSeconds": 300,
    "LeaderElectionRetrySeconds": 10
  },
  "ObjectStorage": {
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Audit": {
    "ChainCount": 16
  }
}
