{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "MaxPoolSize": 20,
    "MinPoolSize": 1,
    "ConnectTimeoutSeconds": 5,
    "WriteCommandTimeoutSeconds": 10,
    "ReadStrongCommandTimeoutSeconds": 5,
    "ReadEventualCommandTimeoutSeconds": 15,
    "MaxAutoPrepare": 20
  },
  "Lease": {
    "TimeToLiveSeconds": 30
  },
  "Partitioning": {
    "MaintenanceEnabled": false,
    "IntervalMinutes": 60,
    "Tables": [
      {
        "Table": "outbox",
        "Granularity": "day",
        "PeriodsAhead": 7
      },
      {
        "Table": "statement",
        "Granularity": "month",
        "PeriodsAhead": 3
      },
      {
        "Table": "audit_event",
        "Granularity": "month",
        "PeriodsAhead": 3
      },
      {
        "Table": "download_token",
        "Granularity": "day",
        "PeriodsAhead": 7
      }
    ]
  },
  "GracefulShutdown": {
    "DrainSeconds": 10,
    "ShutdownTimeoutSeconds": 30
  },
  "Cache": {
    "InstanceName": "download-gateway:"
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "MaxConcurrentDownloads": 64,
    "RedeemPerAddressPerMinute": 30,
    "TrustForwardedHeaders": false,
    "KnownProxies": []
  },
  "ObjectStorage": {
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Audit": {
    "ChainCount": 16
  },
  "Download": {
    "DenialFloorMilliseconds": 50,
    "StreamBufferBytes": 81920,
    "PublicBaseUrl": "http://localhost:8082"
  },
  "ContentStore": {
    "RootPath": "/var/lib/statement-delivery/content"
  }
}
